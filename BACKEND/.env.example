PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
USUARIO_ACTUAL_ID=1
USUARIO_ACTUAL_NOMBRE=Colaborador
USUARIO_ACTUAL_ROL=EMPLEADO
DEEPSEEK_API_KEY=tu_api_key_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=Sistema_de_RRH
DB_HOST=127.0.0.1
DB_PORT=3306

# RAG: módulo de búsqueda vectorial (vacío = búsqueda local de respaldo)
RAG_BUSCADOR_MODULE=
RAG_EMPRESA_ID=1

# RAG multiagente: Neon.tech con pgvector
DATABASE_URL=postgresql://usuario:password@host.neon.tech/base_de_datos?sslmode=require

# RAG multiagente: Google Drive (usa token OAuth o API key)
GOOGLE_ACCESS_TOKEN=tu_access_token_de_google_drive
GOOGLE_DRIVE_API_KEY=tu_api_key_de_google_drive

# RAG multiagente: Voyage AI
VOYAGE_API_KEY=tu_api_key_de_voyage
VOYAGE_MODEL=voyage-3
